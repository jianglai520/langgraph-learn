   "source": [
    "# left:从最开始的位置合并到当前结点的位置的值\n",
    "# right:当前结点的值\n",
    "# 返回值：合并后的值\n",
    "\n",
    "def my_reducer(left: list[str], right: list[str]) -> list[str]:\n",
    "    return left + right\n",
    "\n",
    "# 1.node_1 运行之后的值\n",
    "left = [\"start\", \"node_1运行完毕\"]\n",
    "right = [\"node_2运行完毕\"]\n",
    "\n",
    "merged = my_reducer(left, right)\n",
    "print(merged)"
   ],
